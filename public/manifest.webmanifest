{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "TerraLearn – Interaktywny Globus 3D",
  "short_name": "TerraLearn",
  "description": "Eksploracja geografii fizycznej i politycznej na interaktywnym globusie 3D. Oświetlenie dzień/noc, quiz ślepa mapa, fakty i porównania wielkości.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0a0e17",
  "theme_color": "#0a0e17",
  "icons": [
    {
      "src": "favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "categories": ["education", "games", "geography"]
}
